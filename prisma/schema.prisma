generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole @default(STUDENT)

  profile       UserProfile?
  wallet        WalletAccount?
  enrollments   Enrollment[]
  progress      LessonProgress[]
  referralsSent ReferralInvite[]       @relation("ReferralInviter")
  attempts      PronunciationAttempt[]
  bookmarks     LessonBookmark[]
  recordings    VoiceRecording[]
  authTokens    VerificationToken[]
  coachingGoal  CoachingGoal?

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  referralCode    String?   @unique

  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String?
  planRenewsAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  countryOfResidence String?
  nativeLanguage     String?
  alsoSpeaks         String?
  englishGoal        String?
  proficiencyLevel   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  imageUrl    String?
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  modules     Module[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int     @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id          String  @id @default(cuid())
  moduleId    String
  title       String
  slug        String
  description String?
  videoUrl    String?
  audioUrl    String?
  pdfUrl      String?
  content     String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, slug])
}

model Enrollment {
  id       String           @id @default(cuid())
  userId   String
  courseId String
  status   EnrollmentStatus @default(ACTIVE)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model WalletAccount {
  id           String @id @default(cuid())
  userId       String @unique
  currencyCode String @default("USD")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id              String                @id @default(cuid())
  walletAccountId String
  type            WalletTransactionType
  amountMinor     Int
  currencyCode    String
  description     String?
  referenceType   String?
  referenceId     String?

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ReferralInvite {
  id            String         @id @default(cuid())
  inviterUserId String
  friendEmail   String
  friendName    String?
  referralCode  String
  status        ReferralStatus @default(SENT)

  inviter User @relation("ReferralInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomLesson {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String   @default("Lesson")
  subtitle         String
  description      String
  focus            String   @default("r")
  referenceText    String
  difficulty       String   @default("Beginner")
  estimatedMinutes Int      @default(5)
  audioBase64      String?
  audioMime        String?
  published        Boolean  @default(true)
  sortOrder        Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  dateLabel String   @default("")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model CoachingGoal {
  id            String @id @default(cuid())
  userId        String @unique
  weeklyTarget  Int    @default(4) // practice days per week
  clarityTarget Int? // optional clarity goal (0..100)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      String // "reset" | "verify"
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model VoiceRecording {
  id          String   @id @default(cuid())
  userId      String
  lessonSlug  String?
  focus       String?
  overall     Int?
  mimeType    String   @default("audio/wav")
  audioBase64 String // the recording bytes, base64-encoded (short clips)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LessonBookmark {
  id         String @id @default(cuid())
  userId     String
  lessonSlug String
  kind       String @default("favorite") // "favorite" | "bookmark"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lessonSlug, kind])
  @@index([userId])
}

model PronunciationAttempt {
  id            String  @id @default(cuid())
  userId        String
  lessonSlug    String?
  referenceText String?
  focus         String?
  overall       Int
  rhythm        Int
  source        String  @default("practice-estimate")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum UserRole {
  STUDENT
  ADMIN
  NINA
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum WalletTransactionType {
  STRIPE_PAYMENT
  REFERRAL_CREDIT
  WELCOME_CREDIT
  TRANSFER_SENT
  TRANSFER_RECEIVED
  SUBSCRIPTION_APPLIED
  ADMIN_ADJUSTMENT
  REFUND
}

enum ReferralStatus {
  SENT
  REGISTERED
  SUBSCRIBED
  REWARDED
  CANCELLED
}
