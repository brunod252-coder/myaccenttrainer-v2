generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole @default(STUDENT)

  profile             UserProfile?
  wallet              WalletAccount?
  enrollments         Enrollment[]
  progress            LessonProgress[]
  referralsSent       ReferralInvite[]     @relation("ReferralInviter")
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  countryOfResidence String?
  nativeLanguage     String?
  alsoSpeaks         String?
  englishGoal        String?
  proficiencyLevel   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  imageUrl    String?
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  modules     Module[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int     @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id          String  @id @default(cuid())
  moduleId    String
  title       String
  slug        String
  description String?
  videoUrl    String?
  audioUrl    String?
  pdfUrl      String?
  content     String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, slug])
}

model Enrollment {
  id       String           @id @default(cuid())
  userId   String
  courseId String
  status   EnrollmentStatus @default(ACTIVE)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model WalletAccount {
  id           String @id @default(cuid())
  userId       String @unique
  currencyCode String @default("USD")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id              String                @id @default(cuid())
  walletAccountId String
  type            WalletTransactionType
  amountMinor     Int
  currencyCode    String
  description     String?
  referenceType   String?
  referenceId     String?

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ReferralInvite {
  id            String         @id @default(cuid())
  inviterUserId String
  friendEmail   String
  friendName    String?
  referralCode  String
  status        ReferralStatus @default(SENT)

  inviter User @relation("ReferralInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  STUDENT
  ADMIN
  NINA
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum WalletTransactionType {
  STRIPE_PAYMENT
  REFERRAL_CREDIT
  WELCOME_CREDIT
  TRANSFER_SENT
  TRANSFER_RECEIVED
  SUBSCRIPTION_APPLIED
  ADMIN_ADJUSTMENT
  REFUND
}

enum ReferralStatus {
  SENT
  REGISTERED
  SUBSCRIBED
  REWARDED
  CANCELLED
}
